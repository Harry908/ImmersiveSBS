<Window x:Class="ImmersiveSBS.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:ImmersiveSBS.Theme"
        theme:ThemeManager.IsEnabled="True"
        Title="ImmersiveSBS settings" Width="680" Height="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0 0 0 4"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource AccentButton}" MinWidth="96" Margin="0 0 8 0" Click="OnSave" IsDefault="True"/>
                <Button Content="Cancel" MinWidth="96" Click="OnCancel" IsCancel="True"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24 20 24 24">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
                        <Grid Margin="0 8 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Spins while the depth model loads; a check or a warning once it is done. -->
                            <Ellipse x:Name="ModelSpinner" Width="16" Height="16" Margin="0 0 10 0" VerticalAlignment="Center"
                                     Stroke="{DynamicResource AccentFillBrush}" StrokeThickness="2.5"
                                     StrokeDashArray="5 3" StrokeDashCap="Round" RenderTransformOrigin="0.5 0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="ModelIcon" Style="{StaticResource IconText}" FontSize="16" Margin="0 0 10 0"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="ModelText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock x:Name="MainDisplayWarning" Foreground="{DynamicResource CautionBrush}" TextWrapping="Wrap"
                                   Margin="0 8 0 0" Visibility="Collapsed"
                                   Text="The virtual monitor is your main display: without ImmersiveSBS running, nothing shows the taskbar. Keep a real monitor as the main display, or press Win+P and choose 'PC screen only' to get it back."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0 12 0 0">
                    <StackPanel>
                        <TextBlock Text="Displays" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="Virtual monitor" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="VirtualMonitorBox"/>
                        <TextBlock Text="Glasses" Style="{StaticResource FieldLabel}" Margin="0 16 0 4"/>
                        <ComboBox x:Name="GlassesBox"/>
                        <CheckBox x:Name="ShowIn2DBox" Margin="0 16 0 0" Content="Also show it when the glasses are in 2D mode"/>
                        <CheckBox x:Name="DisconnectBox" Margin="0 8 0 0" Content="Disconnect the virtual monitor while ImmersiveSBS is closed"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0 12 0 0"
                                   Text="Arrange the displays in Windows Settings &gt; System &gt; Display."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0 12 0 0">
                    <StackPanel>
                        <TextBlock Text="3D" Style="{StaticResource SectionText}"/>
                        <CheckBox x:Name="WholeScreenBox" Content="Convert the whole screen to 3D"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0 4 0 0"
                                   Text="Browser video always converts in the 3D theater: the button over a video while the glasses are in 3D mode."/>
                        <TextBlock Text="Depth model" Style="{StaticResource FieldLabel}" Margin="0 16 0 4"/>
                        <ComboBox x:Name="DepthTierBox">
                            <ComboBoxItem Content="Distill-Any-Depth Base (recommended)"/>
                            <ComboBoxItem Content="Depth Anything 3 Small"/>
                            <ComboBoxItem Content="Depth Anything 3 Base"/>
                            <ComboBoxItem Content="Video Depth Anything Small (steadier over time; trial)"/>
                        </ComboBox>
                        <TextBlock Text="Model resolution" Style="{StaticResource FieldLabel}" Margin="0 16 0 4"/>
                        <ComboBox x:Name="DepthPresetBox">
                            <ComboBoxItem Content="Balanced (518×294, recommended)"/>
                            <ComboBoxItem Content="Quality (756×420)"/>
                        </ComboBox>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0 8 0 0"
                                   Text="Timing (live, matched or a buffer) is set in the 3D theater's panel."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0 12 0 0">
                    <StackPanel>
                        <TextBlock Text="Browser extension" Style="{StaticResource SectionText}"/>
                        <TextBlock x:Name="BrowserText" TextWrapping="Wrap"/>
                        <StackPanel x:Name="BrowserHelp" Margin="0 8 0 0">
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="To add it: open edge://extensions or chrome://extensions, turn on Developer mode, choose Load unpacked and pick the extension folder."/>
                            <Button Content="Open extension folder" HorizontalAlignment="Left" Margin="0 8 0 0" Padding="12 4" Click="OnOpenExtensionFolder"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0 12 0 0">
                    <StackPanel>
                        <TextBlock Text="Startup and shortcuts" Style="{StaticResource SectionText}"/>
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows"/>
                        <Grid x:Name="ShortcutsGrid" Margin="0 16 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0 4 0 0"
                                   Text="Like Ctrl+Alt+B; empty for none."/>
                        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource CautionBrush}" TextWrapping="Wrap"
                                   Margin="0 8 0 0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
