<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The release number: in the log, the settings window's title and the package's name. -->
    <Version>1.0.0</Version>
    <Product>ImmersiveSBS</Product>
    <Description>A Windows desktop in video glasses in hardware 3D mode, with AI 2D-to-3D video.</Description>
    <Copyright>GPL-3.0</Copyright>
    <!-- 10.0.19041 (Windows 10 2004): Windows.Graphics.Capture. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- The tray icon and its menu (NotifyIcon, ContextMenuStrip), as in DesktopSbS. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>ImmersiveSBS.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- P/Invoke structs with fixed buffers and COM vtable calls. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF names win: WinForms and System.Drawing are imported per file where used. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- Windows ML, only for its catalog: it installs TensorRT for RTX when it is missing
         (Depth/TensorRtRtx.cs). The package carries its own ONNX Runtime (1.27, same file names
         as ours), so none of its assets are taken: the projection and the catalog's DLL by hand. -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Windows.AI.MachineLearning.Projection">
      <HintPath>$(PkgMicrosoft_Windows_AI_MachineLearning)\lib\net8.0-windows10.0.17763.0\Microsoft.Windows.AI.MachineLearning.Projection.dll</HintPath>
    </Reference>
    <None Include="$(PkgMicrosoft_Windows_AI_MachineLearning)\runtimes\win-x64\native\Microsoft.Windows.AI.MachineLearning.dll"
          Link="Microsoft.Windows.AI.MachineLearning.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="ImmersiveSBS.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The browser extension, next to the app, for "Load unpacked" from the settings window. -->
    <None Include="..\..\extension\**\*" LinkBase="extension" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
