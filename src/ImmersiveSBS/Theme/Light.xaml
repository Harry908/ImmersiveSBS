<!-- Ported from DesktopSbS: DesktopSbS/View/Theme/Light.xaml -->
<!-- Light mode palette. Keys must match Dark.xaml exactly; values follow the
     WinUI 3 Fluent light theme tokens. Accent brushes are set in code by
     ThemeManager from the user's accent colour. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4000000"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9E000000"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#72000000"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5C000000"/>

    <SolidColorBrush x:Key="ControlFillBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#80F9F9F9"/>
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#4DF9F9F9"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#72000000"/>

    <SolidColorBrush x:Key="InputFillBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="InputFillFocusedBrush" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#09000000"/>
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#06000000"/>
    <SolidColorBrush x:Key="SubtleFillSelectedBrush" Color="#0A000000"/>

    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#1F000000"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#72000000"/>

    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TileBorderBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="#29000000"/>

    <SolidColorBrush x:Key="CautionBrush" Color="#9D5D00"/>
    <Color x:Key="ShadowColor">#40000000</Color>
</ResourceDictionary>
