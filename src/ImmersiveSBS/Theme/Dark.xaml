<!-- Ported from DesktopSbS: DesktopSbS/View/Theme/Dark.xaml -->
<!-- Dark mode palette. Keys must match Light.xaml exactly; values follow the
     WinUI 3 Fluent dark theme tokens. Accent brushes are set in code by
     ThemeManager from the user's accent colour. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#19000000"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5DFFFFFF"/>

    <SolidColorBrush x:Key="ControlFillBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#0BFFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="ControlStrongBorderBrush" Color="#8BFFFFFF"/>

    <SolidColorBrush x:Key="InputFillBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="InputFillFocusedBrush" Color="#B31E1E1E"/>

    <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillSelectedBrush" Color="#0FFFFFFF"/>

    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8BFFFFFF"/>

    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="TileBorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="#24FFFFFF"/>

    <SolidColorBrush x:Key="CautionBrush" Color="#FCE100"/>
    <Color x:Key="ShadowColor">#66000000</Color>
</ResourceDictionary>
