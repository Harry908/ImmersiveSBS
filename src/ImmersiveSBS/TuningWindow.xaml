<Window x:Class="ImmersiveSBS.TuningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:ImmersiveSBS.Theme"
        theme:ThemeManager.IsEnabled="True"
        Title="ImmersiveSBS tuning" Width="620" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
            <DockPanel>
                <CheckBox x:Name="TopmostBox" Content="Keep on top" VerticalAlignment="Center" Click="OnTopmost"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reset to defaults" Margin="0 0 8 0" Click="OnReset"/>
                    <Button Content="Save" Style="{StaticResource AccentButton}" MinWidth="96" Margin="0 0 8 0" Click="OnSave"/>
                    <Button Content="Cancel" MinWidth="96" Click="OnCancel"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="24 20 24 16">
            <TextBlock Style="{StaticResource CaptionText}" Margin="0 0 0 12"
                       Text="Changes apply at once. Save keeps them; Cancel goes back to the saved values."/>
            <Grid x:Name="Rows">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
            </Grid>
            <CheckBox x:Name="FloatingWindowBox" Margin="0 12 0 0" Click="OnFloatingWindow"
                      Content="Floating window: black band where something in front touches the side edge"/>
            <CheckBox x:Name="StaticOverlaysBox" Margin="0 8 0 0" Click="OnStaticOverlays"
                      Content="Subtitles and logos at the screen plane (experimental)"/>
            <Border Style="{StaticResource Card}" Margin="0 16 0 0">
                <StackPanel>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatsText" FontFamily="Consolas" FontSize="14" Margin="0 8 0 0"
                               Style="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
