{
  "manifest_version": 3,
  "name": "ImmersiveSBS link",
  "version": "1.0.0",
  "description": "Lets the ImmersiveSBS app on this PC delay a video's sound inside the page, in step with its delayed 3D picture, and find the video exactly.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["alarms"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
